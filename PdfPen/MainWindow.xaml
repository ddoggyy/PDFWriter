<Window x:Class="PdfPen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF Pen" Width="1200" Height="820"
        AllowDrop="True" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="44"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="44"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border x:Name="TopBar" DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <WrapPanel Margin="4" VerticalAlignment="Center">
                <Button Content="열기" Click="Open_Click"/>
                <Button x:Name="SaveButton" Content="저장" Click="Save_Click" ToolTip="Ctrl+S"/>
                <Button Content="다른 이름" Click="SaveAs_Click" ToolTip="Ctrl+Shift+S"/>
                <Button Content="닫기" Click="Close_Click"/>
                <Separator Margin="6,4"/>
                <Button x:Name="UndoButton" Content="↶" Click="Undo_Click" ToolTip="실행 취소 (Ctrl+Z)"/>
                <Button x:Name="RedoButton" Content="↷" Click="Redo_Click" ToolTip="다시 실행 (Ctrl+Y)"/>
                <Separator Margin="6,4"/>
                <ToggleButton x:Name="PenTool" Content="✎ 펜" Click="PenTool_Click"/>
                <ToggleButton x:Name="HighlighterTool" Content="형광펜" Click="HighlighterTool_Click"/>
                <ToggleButton x:Name="EraserTool" Content="지우개" Click="EraserTool_Click"/>
                <Button Content="페이지 필기 삭제" Click="ClearPage_Click"/>
                <StackPanel x:Name="Swatches" Orientation="Horizontal" Margin="6,0,0,0"/>
                <TextBlock Text="굵기" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <Slider x:Name="WidthSlider" Width="110" Minimum="0.5" Maximum="24" VerticalAlignment="Center"
                        ValueChanged="WidthSlider_ValueChanged"/>
                <CheckBox x:Name="MouseInkBox" Content="마우스 필기" IsChecked="True" VerticalAlignment="Center" Margin="10,0,0,0"
                          ToolTip="끄면 마우스는 필기하지 않고 펜만 필기합니다"/>
                <Separator Margin="6,4"/>
                <Button Content="－" Click="ZoomOut_Click" ToolTip="축소 (Ctrl+-)"/>
                <TextBlock x:Name="ZoomText" Text="100%" VerticalAlignment="Center" Width="48" TextAlignment="Center"/>
                <Button Content="＋" Click="ZoomIn_Click" ToolTip="확대 (Ctrl++)"/>
                <Button Content="페이지 맞춤" Click="FitPage_Click"/>
                <Button Content="너비 맞춤" Click="FitWidth_Click"/>
                <Button Content="전체화면" Click="Fullscreen_Click" ToolTip="F11"/>
            </WrapPanel>
        </Border>
        <Border x:Name="BottomBar" DockPanel.Dock="Bottom" Background="#F3F3F3" BorderBrush="#DDD" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="4">
                <Button Content="◀" Click="Prev_Click" MinWidth="64"/>
                <TextBox x:Name="PageBox" Width="48" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                         Margin="8,2,2,2" KeyDown="PageBox_KeyDown" GotKeyboardFocus="PageBox_GotFocus"/>
                <TextBlock x:Name="PageCountText" Text="/ 0" VerticalAlignment="Center" Margin="4,0,8,0"/>
                <Button Content="▶" Click="Next_Click" MinWidth="64"/>
            </StackPanel>
        </Border>
        <ScrollViewer x:Name="Scroller" Background="#606060"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      PanningMode="Both"
                      PreviewMouseWheel="Scroller_PreviewMouseWheel" Focusable="False">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                <Image x:Name="PageImage" Stretch="Fill" SnapsToDevicePixels="True"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <!-- 필기 레이어: 크기는 PDF 포인트 단위, 화면 배율은 LayoutTransform 으로 적용 -->
                <InkCanvas x:Name="Ink" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top"
                           Visibility="Collapsed" UseCustomCursor="False"
                           PreviewStylusDown="Ink_PreviewStylusDown" PreviewMouseDown="Ink_PreviewMouseDown"/>
                <TextBlock x:Name="Hint" Foreground="#DDD" FontSize="18" TextAlignment="Center"
                           Text="PDF를 열거나 이 창에 끌어다 놓으세요"/>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
